{
  "manifest_version": 3,
  "name": "Studojo LinkedIn Connector",
  "version": "1.0.0",
  "description": "One-click LinkedIn session connector for Studojo outreach",
  "permissions": ["cookies"],
  "host_permissions": [
    "https://www.linkedin.com/",
    "https://studojo.pro/",
    "https://studojo.com/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://studojo.pro/*",
        "https://studojo.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Studojo LinkedIn Connector"
  }
}
